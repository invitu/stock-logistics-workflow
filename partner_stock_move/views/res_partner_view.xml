<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="act_partner_stock_move" model="ir.actions.act_window">
        <field name="res_model">stock.move</field>
        <field name="name">Stock moves action</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[("picking_id.partner_id", "child_of", active_ids)]</field>
    </record>
    <record model="ir.ui.view" id="view_partner_form_stock_move">
        <field name="name">Partner Form with stock moves</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="%(partner_stock_move.act_partner_stock_move)d"
                    type="action"
                    class="oe_stat_button oe_inline"
                    icon="fa-arrows-v"
                    invisible="stock_move_count == 0"
                    groups="stock.group_stock_user"
                >
                    <field
                        name="stock_move_count"
                        widget="statinfo"
                        String="Stock moves"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
